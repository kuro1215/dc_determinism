@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG REQUIRED HINTS "${PACKAGE_PREFIX_DIR}")

if(@DIGITALCURLING_PACKAGE_NEEDS_BOX2D@)
    find_dependency(box2d CONFIG REQUIRED HINTS "${PACKAGE_PREFIX_DIR}")
endif()

if(NOT @DIGITALCURLING_BUNDLE_PLUGINS@)
    # Directory the dynamically loaded plugins were installed to.
    set(DIGITALCURLING_PLUGIN_INSTALL_DIR "@PACKAGE_DIGITALCURLING_PLUGIN_INSTALL_DIR@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DigitalCurlingTargets.cmake")
target_link_libraries(digitalcurling::core INTERFACE nlohmann_json::nlohmann_json)
check_required_components(DigitalCurling)
