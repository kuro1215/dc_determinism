+/// \brief Same pipeline as simulator(), additionally returning the recorded frames.
+/// \param[in] frame_stride Number of world steps (0.001 s each) per recorded frame.
+/// \param[in] removal_sheet_width Sheet width for the FCV1Plus play-area removal (<= 0 disables it).
+/// \returns (final_state, frames float32 (F, 16, 6) = (x, y, body angle, vx, vy, w), steps executed, removal step per slot or -1)
+std::tuple<py::array_t<double, 3>, py::array_t<float>, int, std::vector<int>> StoneSimulator::simulator_frames(py::array_t<double> stone_positions, int total_shot, double x_velocity, double y_velocity, double angular_velocity, unsigned int team_id, unsigned int shot_per_team, unsigned int applied_rule, int frame_stride, double removal_sheet_width)
+{
+    if (frame_stride < 1)
+    {
+        throw py::value_error("frame_stride must be >= 1");
+    }
+    frame_stride_ = frame_stride;
+    removal_sheet_width_ = static_cast<float>(removal_sheet_width);
+    py::array_t<double, 3> final_state;
+    try
+    {
+        final_state = std::get<0>(simulator(stone_positions, total_shot, x_velocity, y_velocity, angular_velocity, team_id, shot_per_team, applied_rule));
+    }
+    catch (...)
+    {
+        frame_stride_ = 10;
+        removal_sheet_width_ = 0.f;
+        throw;
+    }
+    frame_stride_ = 10;
+    removal_sheet_width_ = 0.f;
+
+    const std::vector<float> &flat = simulatorFCV1->recorded_frames();
+    const py::ssize_t frame_count = static_cast<py::ssize_t>(flat.size() / (kStoneMax * SimulatorFCV1::kRecordFields));
+    py::array_t<float> frames(std::vector<py::ssize_t>{frame_count, static_cast<py::ssize_t>(kStoneMax), static_cast<py::ssize_t>(SimulatorFCV1::kRecordFields)});
+    std::copy(flat.begin(), flat.end(), frames.mutable_data());
+    return std::make_tuple(final_state, frames, simulatorFCV1->recorded_step_count(), simulatorFCV1->removed_steps());
+}
+
 // main関数
 
 PYBIND11_MODULE(simulator, m)
 {
     py::class_<StoneSimulator>(m, "StoneSimulator")
         .def(py::init<>())
-        .def("simulator", &StoneSimulator::simulator);
+        .def("simulator", &StoneSimulator::simulator)
+        .def("simulator_frames", &StoneSimulator::simulator_frames,
+             py::arg("stone_positions"), py::arg("total_shot"), py::arg("x_velocity"), py::arg("y_velocity"),
+             py::arg("angular_velocity"), py::arg("team_id"), py::arg("shot_per_team"), py::arg("applied_rule"),
+             py::arg("frame_stride") = 10, py::arg("removal_sheet_width") = 4.75);
+    m.attr("DEFAULT_FRAME_STRIDE") = 10;
+    m.attr("RECORD_VERSION") = 2;
+    m.attr("FRAME_FIELDS") = static_cast<int>(SimulatorFCV1::kRecordFields);
 }
