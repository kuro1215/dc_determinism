+void SimulatorFCV1::record_frame()
+{
+    for (size_t i = 0; i < kStoneMax; ++i)
+    {
+        b2Body *body = stone_bodies[i];
+        if (body->IsEnabled() && removed_steps_[i] < 0)
+        {
+            const b2Vec2 position = body->GetPosition();
+            const b2Vec2 velocity = body->GetLinearVelocity();
+            frames_.push_back(position.x);
+            frames_.push_back(position.y);
+            frames_.push_back(body->GetAngle());
+            frames_.push_back(velocity.x);
+            frames_.push_back(velocity.y);
+            frames_.push_back(body->GetAngularVelocity());
+        }
+        else
+        {
+            for (int field = 0; field < kRecordFields; ++field)
+            {
+                frames_.push_back(0.f); // absent stone: all fields zero
+            }
+        }
+    }
+}
+
+/// Mirrors DigitalCurling.Plugins SimulatorSimulate(): after each step a stone outside
+/// |x| < sheet_width / 2 - radius, 0 <= y <= kBackBoardY (43.892) - radius leaves the board.
+/// Recording only: the body keeps moving so that the physics stays the tournament engine's.
+void SimulatorFCV1::remove_out_of_play_area()
+{
+    if (removal_sheet_width_ <= 0.f)
+    {
+        return;
+    }
+    const float x_limit = removal_sheet_width_ / 2.0f - kStoneRadius;
+    const float y_limit = 43.892f - kStoneRadius;
+    for (size_t i = 0; i < kStoneMax; ++i)
+    {
+        b2Body *body = stone_bodies[i];
+        if (!body->IsEnabled() || removed_steps_[i] >= 0)
+        {
+            continue;
+        }
+        const b2Vec2 position = body->GetPosition();
+        if (!(std::abs(position.x) < x_limit && position.y <= y_limit && position.y >= 0.f))
+        {
+            removed_steps_[i] = step_count_;
+        }
+    }
+}
+
